# AI Boardroom environment
PORT=8080

# Primary LLM (Gemini) — also enables voice
GEMINI_API_KEY=

# Fallback LLM router
OPENROUTER_API_KEY=

# Optional: protect /api/execution/* 
BOARDROOM_API_KEY=

# Optional CORS lockdown (comma-separated). Empty = allow all.
ALLOWED_ORIGINS=

# Vault path (relative or absolute)
OBSIDIAN_VAULT_PATH=./obsidian_vault

# Optional model overrides
# MODEL_JARVIS=gemini-2.5-flash
# MODEL_CEO=gemini-2.5-pro
# MODEL_CTO=gemini-2.5-pro
